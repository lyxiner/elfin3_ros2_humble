<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>elfin3_ros2_gazebo</name>
  <version>0.0.0</version>
  <description>Gazebo simulation assets (URDF/xacro, world, gazebo_ros2_control config) for the Elfin3 robot, ROS2 Humble.</description>
  <maintainer email="cjw@todo.todo">cjw</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- runtime -->
  <exec_depend>xacro</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>

  <exec_depend>gazebo_ros</exec_depend>
  <exec_depend>gazebo_ros2_control</exec_depend>

  <exec_depend>controller_manager</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>
  <exec_depend>joint_trajectory_controller</exec_depend>

  <!-- Provides the actual STL meshes referenced by elfin3.urdf.xacro -->
  <exec_depend>elfin_description</exec_depend>

  <!-- The real-hardware plugin lives here; we don't need it to launch
       gazebo sim, but xacro's <plugin> tag in elfin3_gazebo.xacro references
       it, so listing it is the safest. -->
  <exec_depend>elfin_ros_control</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>